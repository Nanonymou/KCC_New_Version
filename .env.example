# ─── KCC environment ───────────────────────────────────────────────────────
# Copy to .env for local development. On Vercel these are injected automatically
# when you attach a Vercel Postgres (Neon) store to the project.

# Postgres connection string (pooled). Vercel Postgres provides this as
# POSTGRES_URL when you create/attach the database in the Storage tab.
POSTGRES_URL="postgres://user:password@host-pooler.region.aws.neon.tech/dbname?sslmode=require"

# Optional: only needed if you run migrations / non-pooled connections.
# POSTGRES_URL_NON_POOLING="postgres://user:password@host.region.aws.neon.tech/dbname?sslmode=require"

# Optional: point the frontend at an API hosted on a different origin.
# Leave unset for same-origin (recommended).
# VITE_API_BASE="https://your-api-project.vercel.app"
